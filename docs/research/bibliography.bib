@article{campbell2018recruitment,
  author  = {Campbell, Kenneth S. and Janssen, Paul M. L. and Campbell, Stuart G.},
  title   = {Force-Dependent Recruitment from the Myosin Off State Contributes to
             Length-Dependent Activation},
  journal = {Biophysical Journal},
  volume  = {115},
  number  = {3},
  pages   = {543--553},
  year    = {2018},
  doi     = {10.1016/j.bpj.2018.07.006},
  note    = {THE primary source for Layer 1's state scheme. Six states: thin-filament
             sites off/on/bound and myosin OFF/ON/force-generating. Fitted values include
             k_on = 2.08e7 per molar per second and a cooperativity coefficient of 5.70.
             The central result is that a model in which the off-to-on transition rate
             rises linearly with force reproduces length-dependent activation
             significantly better than one with a constant rate (F-test, p < 0.001).}
}

@article{campbell2020espvr,
  title   = {Force-dependent recruitment from myosin {OFF}-state increases end-systolic
             pressure-volume relationship in left ventricle},
  journal = {Biomechanics and Modeling in Mechanobiology},
  volume  = {19},
  pages   = {2079--2088},
  year    = {2020},
  doi     = {10.1007/s10237-020-01331-6},
  note    = {Carries the Campbell recruitment mechanism up to the whole-ventricle scale
             and shows it steepens the end-systolic pressure-volume relationship, which
             is exactly the failure mode this project hit without it.}
}

@article{arts1991onefiber,
  author  = {Arts, Theo and Bovendeerd, Peter H. M. and Prinzen, Frits W. and
             Reneman, Robert S.},
  title   = {Relation between left ventricular cavity pressure and volume and systolic
             fiber stress and strain in the wall},
  journal = {Biophysical Journal},
  volume  = {59},
  number  = {1},
  pages   = {93--102},
  year    = {1991},
  doi     = {10.1016/S0006-3495(91)82201-9},
  note    = {THE primary source for Layer 2. Under rotational symmetry and homogeneous
             wall load, sigma_f = p_lv (1 + 3 V_lv / V_w) and
             d(eps_f) = (1/3) d[ln(1 + 3 V_lv / V_w)], with the stress-to-pressure ratio
             depending mainly on the cavity-to-wall volume ratio and being largely
             independent of other geometric detail.}
}

